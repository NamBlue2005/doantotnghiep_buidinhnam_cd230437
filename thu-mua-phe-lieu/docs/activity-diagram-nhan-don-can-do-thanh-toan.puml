@startuml
title 2.3.2. Luồng quy trình nhận đơn, cân đo và thanh toán (Tài xế)

start

partition "Tài xế" {
  :Truy cập tab "Đơn hàng chờ nhận";
  :Xem danh sách các đơn PENDING;
  :Chọn một đơn hàng phù hợp;
  :Bấm "Nhận đơn";
}

partition "Hệ thống" {
  if (Đơn hàng còn khả dụng?) then (No)
    :Báo lỗi "Đơn hàng không khả dụng";
    :Quay lại danh sách đơn chờ nhận;
    stop
  else (Yes)
    :Gán ID tài xế vào đơn;
    :Đổi trạng thái thành ACCEPTED;
    :Hiển thị số điện thoại và địa chỉ khách hàng;
  endif
}

partition "Tài xế" {
  :Di chuyển đến điểm hẹn;
  :Gặp khách và cân đo khối lượng thực tế;
}

partition "Hệ thống" {
  if (Có sai lệch khối lượng / giá so với ban đầu?) then (Yes)
    :Cho phép tài xế cập nhật số lượng / tổng tiền thực tế;
  else (No)
    :Giữ nguyên thông tin ban đầu;
  endif
}

partition "Tài xế" {
  :Chọn phương thức thanh toán;
  :Thực hiện chuyển tiền ngoài thực tế cho khách;
  :Bấm "Hoàn thành đơn";
}

partition "Hệ thống" {
  :Lưu phương thức thanh toán;
  :Đổi trạng thái đơn thành COMPLETED;
  :Cộng điểm thưởng;
}

stop

@enduml